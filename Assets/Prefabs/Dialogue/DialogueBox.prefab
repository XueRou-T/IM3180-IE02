--- !u!114 &3942304042872357358
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2609887327216478906}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 60a2ea689a8d0f244a43fa1708bb29fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 6735154406528815058}
  nameComponent: {fileID: 5323211691345532592}
  avatarOneImage: {fileID: 7672522118020972351}
  avatarTwoImage: {fileID: 5641740497899541933}
  dimAmount: 0.4
  audioSource: {fileID: 693766867697467656}
  typingSound: {fileID: 8300000, guid: fb2b57bfaae3d974cb28978767105caa, type: 3}
  soundFrequency: 1
  lines:
  - speakerName: Sharon
    speakerAvatar: {fileID: -2353376327185201564, guid: d68c346715fff4c4c8f2b9d43f23ff93, type: 3}
    text: '"It''s been so long since we last ate out..."'
  - speakerName: Sharon
    speakerAvatar: {fileID: -2353376327185201564, guid: d68c346715fff4c4c8f2b9d43f23ff93, type: 3}
    text: '"Shall we head to the hawker center downstairs to have lunch?"'
  - speakerName: John
    speakerAvatar: {fileID: -4281445024243405800, guid: e3f97b872daa05946a24f0a862540432, type: 3}
    text: '"I''m busy."'
  - speakerName: Sharon
    speakerAvatar: {fileID: -2353376327185201564, guid: d68c346715fff4c4c8f2b9d43f23ff93, type: 3}
    text: '"Can''t you spare just one hour of your day to have lunch with your WIFE?"'
  - speakerName: John
    speakerAvatar: {fileID: -4281445024243405800, guid: e3f97b872daa05946a24f0a862540432, type: 3}
    text: '"You don''t understand, I''m working on something really important."'
  - speakerName: Sharon
    speakerAvatar: {fileID: -2353376327185201564, guid: d68c346715fff4c4c8f2b9d43f23ff93, type: 3}
    text: '"And somehow it''s more important than our marriage??"'
  - speakerName: John
    speakerAvatar: {fileID: -4281445024243405800, guid: e3f97b872daa05946a24f0a862540432, type: 3}
    text: '"You will never understand! I NEED to work on this!"'
  - speakerName: Sharon
    speakerAvatar: {fileID: -2353376327185201564, guid: d68c346715fff4c4c8f2b9d43f23ff93, type: 3}
    text: '"Sigh..."'
  - speakerName: Sharon
    speakerAvatar: {fileID: -2353376327185201564, guid: d68c346715fff4c4c8f2b9d43f23ff93, type: 3}
    text: '"He''s always working... I guess I''ll just have lunch on my own..." '
  textSpeed: 0.1
  nextSceneName: 
  fadeImage: {fileID: 0}
