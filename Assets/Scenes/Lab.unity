    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: fadeImage
      value: 
      objectReference: {fileID: 307611163}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: nextSceneName
      value: TrueEnd
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[0].text
      value: I may not remember everything, but I won't erase my memories anymore.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[1].text
      value: I'm sorry, Shannon. I tried to forget you. I tried to erase my mistakes,
        hoping the pain would disappear.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[2].text
      value: But I know you wouldn't want me to live like this. I'll try to move
        forward, carrying our memories with me.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[3].text
      value: I promise... I'll do my best not to make the same mistake again.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[0].speakerName
