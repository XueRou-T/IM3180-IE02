    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: nextSceneName
      value: EndingExplosion
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[0].text
      value: I'm sorry, Shannon... I can't live with these memories. I can't bear
        living in a world without you.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[1].text
      value: I'll erase my memories once again. Whatever it takes... I just want
        to live a normal life again.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[2].text
      value: I'm so sorry Sharon. I should've be there with you.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[3].text
      value: What shall I do now?
      objectReference: {fileID: 0}
