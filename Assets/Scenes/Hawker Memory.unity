    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: fadeImage
      value: 
      objectReference: {fileID: 451007803}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: nextSceneName
      value: HawkerCentre
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[0].text
      value: It's been so long since we last ate out...
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[1].text
      value: Shall we head to the hawker center downstairs to have lunch?
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[2].text
      value: I'm busy.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[3].text
      value: Can't you spare just one hour of your day to have lunch with your WIFE?
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[4].text
      value: You don't understand, I'm working on something really important.
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[5].text
      value: And somehow it's more important than our marriage??
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[6].text
      value: You will never understand! I NEED to work on this!
      objectReference: {fileID: 0}
    - target: {fileID: 3942304042872357358, guid: edec39da6b5fcc4469939a92f5118ff1, type: 3}
      propertyPath: lines.Array.data[7].text
